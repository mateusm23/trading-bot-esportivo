# Token do bot (obtenha com @BotFather no Telegram)
TELEGRAM_BOT_TOKEN=

# ID do chat para receber alertas
# Como obter: envie mensagem ao bot e acesse:
# https://api.telegram.org/bot<TOKEN>/getUpdates -> resultado[0].message.chat.id
TELEGRAM_CHAT_ID=

# URL da API do Momentum Bet (padrao: localhost:8080)
MOMENTUM_API_URL=http://localhost:8080
